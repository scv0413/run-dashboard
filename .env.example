# .env 로 복사해서 값을 채운다 (cp .env.example .env). .env 는 git에 올리지 않는다.

# Supabase — Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 서버 전용 secret key (sb_secret_... 또는 레거시 service_role). 절대 프론트에 넣지 않는다
SUPABASE_SECRET_KEY=
# 프론트(index.html)에 넣을 publishable key (sb_publishable_... 또는 레거시 anon). 공개돼도 RLS로 읽기만 가능
SUPABASE_PUBLISHABLE_KEY=
